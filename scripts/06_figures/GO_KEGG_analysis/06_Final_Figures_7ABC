# Drop a term if its leading-edge genes are largely contained within those of
# a more significant term. Overlap coefficient, not Jaccard, so that a child
# term nested inside a parent is caught regardless of the size difference.
collapse_redundant <- function(df, cut) {
  if (nrow(df) == 0) return(df)
  df   <- df[order(df$p.adjust), ]
  sets <- strsplit(df$core_enrichment, "/")
  keep <- logical(nrow(df))
  for (i in seq_len(nrow(df))) {
    if (!any(keep)) { keep[i] <- TRUE; next }
    ov <- vapply(which(keep), function(k)
      length(intersect(sets[[i]], sets[[k]])) / min(length(sets[[i]]), length(sets[[k]])),
      numeric(1))
    if (max(ov) < cut) keep[i] <- TRUE
  }
  df[keep, ]
}

curate <- function(onto, dir_keep) {
  
  sig <- gsea %>% filter(ontology == onto, direction == dir_keep, p.adjust < PADJ)
  if (!nrow(sig)) return(list(display = sig, all = sig))
  
  # represent each term by the UNION of its leading-edge genes across all
  # comparisons, so terms driven by the same genes anywhere are collapsed
  rep_terms <- sig %>%
    group_by(ID) %>%
    summarise(p.adjust = min(p.adjust),
              core_enrichment = paste(unique(unlist(strsplit(core_enrichment, "/"))),
                                      collapse = "/"),
              .groups = "drop")
  kept <- collapse_redundant(as.data.frame(rep_terms), OVERLAP_CUT)$ID
  
  # every significant term is retained here, flagged; the supplementary file
  # must contain the terms the collapse removed, or the threshold is not
  # reversible by a reader
  all_terms <- sig %>%
    group_by(ID) %>% mutate(N_clusters = n_distinct(cluster)) %>% ungroup() %>%
    mutate(Kept_after_collapse = ID %in% kept,
           Displayed           = Kept_after_collapse & N_clusters >= MIN_CLUSTERS)
  
  cat(sprintf("\n%-6s %-14s  %3d rows | %3d terms | %3d collapsed | %3d shown (>=%d clusters)\n",
              onto, dir_keep, nrow(sig), n_distinct(sig$ID),
              length(kept), n_distinct(all_terms$ID[all_terms$Displayed]),
              MIN_CLUSTERS))
  
  list(display = filter(all_terms, Displayed), all = all_terms)
}

