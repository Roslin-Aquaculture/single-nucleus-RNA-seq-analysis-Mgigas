# SUPPLEMENTARY TABLE
# =========================================================
# Analysis and Direction describe the slice, so the file stands alone
# without the figure beside it. Figure_panel is filled only for terms
# actually drawn: the file also carries the terms the collapse and
# breadth rules removed, and those appear in no panel.
as_table <- function(d, p, cfg) {
  d %>% arrange(desc(Displayed), desc(N_clusters), ID, p.adjust) %>%
    rowwise() %>%
    mutate(Genes = name_of(strsplit(core_enrichment, "/")[[1]])) %>%
    ungroup() %>%
    transmute(
      Analysis     = cfg$title,
      Direction    = cfg$dir,
      Figure_panel = ifelse(Displayed, paste0("Fig. 7", p), NA_character_),
      Cluster      = gsub("_", " ", cluster),
      Stage        = stage,
      Ontology     = ontology, Term_ID = ID, Term = Description,
      N_clusters, Kept_after_collapse, Displayed,
      Set_size = setSize, NES = round(NES, 3),
      FDR = signif(p.adjust, 3),
      Leading_edge_genes = Genes, Leading_edge_ids = core_enrichment)
}

