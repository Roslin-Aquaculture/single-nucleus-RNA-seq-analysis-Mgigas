  rename(query = 1) %>%
  mutate(gene_id = sub("\\.\\d+$", "", sub("^transcript:", "", query)))

name_of <- function(ids) {
  i  <- match(ids, egg$gene_id)
  nm <- egg$Preferred_name[i]; pf <- egg$PFAMs[i]
  bad <- function(x) is.na(x) | x == "-" | x == ""
  nm[bad(nm)] <- pf[bad(nm)]
  nm[bad(nm)] <- ids[bad(nm)]
  paste(unique(nm), collapse = ", ")
}

